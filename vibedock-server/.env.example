# Set your own password before starting the server.
ADMIN_USER=admin
ADMIN_PASSWORD=
API_BIND_ADDRESS=0.0.0.0
# Administration is reachable from the network; use 127.0.0.1 to limit it to this host.
ADMIN_PUBLISH_ADDRESS=0.0.0.0
TIME_ZONE=Europe/Berlin
# Addresses announced to devices when they are invited (also settable in the administration UI).
# INTERNAL_URL defaults to the host used to open the administration UI, port 10002.
# INTERNAL_URL=http://192.168.1.10:10002
# EXTERNAL_URL=https://vibedock.example.com
# Build without "bake", which would ask on the terminal before reading ../.git (the version source).
COMPOSE_BAKE=false
# Optional: data directory mounted at /data (default ./docker.data, relative to
# this directory). It contains credentials and is excluded from Git and the build.
# VIBEDOCK_DATA_PATH=./docker.data
# Optional: the published image instead of building it (docker compose pull && docker compose up -d).
# VIBEDOCK_IMAGE=mcfcologne/vibedock-server:latest     # or ghcr.io/mcfcologne/vibedock-server:latest
